{
  "name": "google-drive-client",
  "version": "1.0.0",
  "description": "Google Drive Client - Electron + React + TypeScript",
  "license": "ISC",
  "author": "Jan Přikryl",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -r \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "tsc && vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "cz.prikryl.googledriveclient",
    "productName": "Google Drive Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ]
  }
}
